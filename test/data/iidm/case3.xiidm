<?xml version="1.0" encoding="UTF-8"?>
<!--
  3-bus test network for IIDM importer tests.

  Topology:
    Bus 1 — generator (slack)
    Bus 2 — load (P=30 MW, Q=10 MVAr)
    Bus 3 — load (P=20 MW, Q=5 MVAr)
    Line 1-2: R=1 Ω, X=5 Ω, b1=b2=0.0005 S
    Line 2-3: R=0.5 Ω, X=2 Ω, b1=b2=0.0002 S

  Base: nominalV=100 kV, baseMVA=100
  Z_base = 100^2 / 100 = 100 Ω

  Per-unit values:
    Line 1-2:  R=0.01, X=0.05, B=(0.0005+0.0005)*100=0.1
    Line 2-3:  R=0.005, X=0.02, B=(0.0002+0.0002)*100=0.04
-->
<iidm:network xmlns:iidm="http://www.powsybl.org/schema/iidm/1_13"
              id="case3"
              caseDate="2024-01-01T00:00:00.000+00:00"
              forecastDistance="0"
              sourceFormat="handcrafted"
              minimumValidationLevel="STEADY_STATE_HYPOTHESIS">

  <iidm:substation id="S1" country="DE">
    <iidm:voltageLevel id="VL1" nominalV="100.0" topologyKind="BUS_BREAKER">
      <iidm:busBreakerTopology>
        <iidm:bus id="B1" v="105.0" angle="0.0"/>
      </iidm:busBreakerTopology>
      <iidm:generator id="G1" energySource="OTHER"
                 minP="0.0" maxP="200.0"
                 targetP="50.0" targetQ="0.0" targetV="105.0"
                 voltageRegulatorOn="true"
                 bus="B1" connectableBus="B1">
        <iidm:minMaxReactiveLimits minQ="-200.0" maxQ="200.0"/>
      </iidm:generator>
    </iidm:voltageLevel>
  </iidm:substation>

  <iidm:substation id="S2" country="DE">
    <iidm:voltageLevel id="VL2" nominalV="100.0" topologyKind="BUS_BREAKER">
      <iidm:busBreakerTopology>
        <iidm:bus id="B2" v="100.0" angle="0.0"/>
      </iidm:busBreakerTopology>
      <iidm:load id="L2" loadType="UNDEFINED" p0="30.0" q0="10.0"
            bus="B2" connectableBus="B2"/>
    </iidm:voltageLevel>
  </iidm:substation>

  <iidm:substation id="S3" country="DE">
    <iidm:voltageLevel id="VL3" nominalV="100.0" topologyKind="BUS_BREAKER">
      <iidm:busBreakerTopology>
        <iidm:bus id="B3" v="100.0" angle="0.0"/>
      </iidm:busBreakerTopology>
      <iidm:load id="L3" loadType="UNDEFINED" p0="20.0" q0="5.0"
            bus="B3" connectableBus="B3"/>
    </iidm:voltageLevel>
  </iidm:substation>

  <iidm:line id="L1_2" r="1.0" x="5.0" g1="0.0" b1="0.0005" g2="0.0" b2="0.0005"
        voltageLevelId1="VL1" bus1="B1" connectableBus1="B1"
        voltageLevelId2="VL2" bus2="B2" connectableBus2="B2"/>

  <iidm:line id="L2_3" r="0.5" x="2.0" g1="0.0" b1="0.0002" g2="0.0" b2="0.0002"
        voltageLevelId1="VL2" bus1="B2" connectableBus1="B2"
        voltageLevelId2="VL3" bus2="B3" connectableBus2="B3"/>

</iidm:network>
